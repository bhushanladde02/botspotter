# Copy to .env and change every value marked CHANGE.
# Keep .env out of git (it is in .gitignore).

PG_PASSWORD=CHANGE-long-random

# Sensor API keys: "key:site_id,key:site_id". Generate with `openssl rand -hex 16`.
# The portal itself needs none. Add one line per site you own, then share
# keys with site owners who install a sensor.
BS_SENSOR_KEYS=CHANGE-me-hex:bhushan-profile,CHANGE-me-hex:recovery-routes,CHANGE-me-hex:honeypot-1

# Renaming salt. Changing it renames EVERY bot. Set once, never touch.
BS_NAMING_SALT=CHANGE-once-random

# Secret prefix for the daily human-visitor hash.
BS_VISITOR_SECRET=CHANGE-long-random

# Optional: path to GeoLite2-City.mmdb inside the container (mount it) for
# city-level dots. Without it the map uses Cloudflare's country header.
# BS_GEOIP_DB=/app/GeoLite2-City.mmdb

# Discovery rule for unknown bots: distinct sites within window.
BS_DISCOVERY_MIN_SITES=3
BS_DISCOVERY_WINDOW_S=86400

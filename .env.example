# Copy to .env and change every value marked CHANGE.
# Keep .env out of git (it is in .gitignore).

PG_PASSWORD=CHANGE-long-random

# Sensor API keys: "key:site_id,key:site_id". Generate with `openssl rand -hex 16`.
# The portal itself needs none. Add one line per site you own, then share
# keys with site owners who install a sensor.
BS_SENSOR_KEYS=CHANGE-me-hex:bhushan-profile,CHANGE-me-hex:recovery-routes,CHANGE-me-hex:honeypot-1

# Renaming salt. Changing it renames EVERY bot. Set once, never touch.
BS_NAMING_SALT=CHANGE-once-random

# Secret prefix for the daily human-visitor hash.
BS_VISITOR_SECRET=CHANGE-long-random

# Optional: path to GeoLite2-City.mmdb inside the container (mount it) for
# city-level dots. Without it the map uses Cloudflare's country header.
# BS_GEOIP_DB=/data/GeoLite2-City.mmdb
# BS_GEOIP_ASN_DB=/data/GeoLite2-ASN.mmdb   (hosting labels: AWS/Azure/GCP...)
# BS_RUNTIME_DIR=/data                       (crawler_ranges.json, sensors.json overrides)
# DATA_DIR=/home/ubuntu/botspotter-data      (host path mounted at /data; deploy/refresh-data.sh fills it)

# Discovery rule for unknown bots: distinct sites within window.
BS_DISCOVERY_MIN_SITES=3
BS_DISCOVERY_WINDOW_S=86400

# Shared-VM deploy only (deploy/oracle.sh fills this): the docker network of the
# existing Caddy container that fronts the box.
# CADDY_NETWORK=deploy_default

# Owner key for the audience ledger (/admin and /v1/admin/*). Unset = those routes 404.
# deploy/remote.sh generates one on the VM; keep it in private/notes.md, never in git.
# BS_ADMIN_KEY=

# Self-serve sensor enrollment (docs/runbook.rst "Enrollment"): a GitHub OAuth app whose
# callback is <BS_PUBLIC_URL>/auth/github/callback. Unset = /sensors shows the e-mail route.
# BS_GITHUB_CLIENT_ID=
# BS_GITHUB_CLIENT_SECRET=
# BS_SESSION_SECRET=      (remote.sh generates one; rotating it signs everyone out)
# BS_PUBLIC_URL=https://botspotter.app
